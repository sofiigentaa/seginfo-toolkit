# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_USER=sentinelops
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sentinelops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Auth service ---
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Login/registro con Google (opcional). Sacar el Client ID desde
# https://console.cloud.google.com/apis/credentials -> Crear
# credenciales -> ID de cliente de OAuth -> Aplicacion web, con
# http://localhost:5173 en 'Origenes de JavaScript autorizados'.
# Mismo valor en las dos variables (el Client ID de Google es
# publico, lo usa el frontend para el boton y el backend para
# validar el token). Si se deja vacio, el boton de Google no
# aparece y el login sigue funcionando con email/password.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER_NAME=SentinelOps

# --- Suscripcion / licencia (ver backend/shared/license_check.py y
# licensing-server/) ---
# Todas estas quedan VACIAS por defecto: sin LICENSE_SERVER_URL,
# auth-service solo usa el vencimiento local (Organization.subscription_expires_at,
# gestionado a mano via POST /auth/organizations/{id}/subscription/extend).
# Completalas SOLO en una instalacion que vaya a validar contra el
# servidor central de licencias del operador.
#
# LICENSE_SERVER_URL: URL publica del servidor central (ver licensing-server/README.md).
# LICENSE_KEY: la license_key que el operador te dio para ESTA instalacion.
# LICENSE_SERVER_PUBLIC_KEY: clave publica Ed25519 (base64) del servidor
#   central -- la imprime licensing-server/generate_keys.py. Es publica
#   por diseño (solo permite VERIFICAR, nunca fabricar, una respuesta).
LICENSE_SERVER_URL=
LICENSE_KEY=
LICENSE_SERVER_PUBLIC_KEY=B88iF4/B5QWJ+BwVfobj2xcfGBB85Tkt2M4nBh90Ajg=
# Cada cuantas horas auth-service vuelve a confirmar la licencia contra
# el servidor central (solo aplica si LICENSE_SERVER_URL esta seteado).
LICENSE_CHECK_INTERVAL_HOURS=6

# --- Seguridad (CORS y cifrado de secretos en reposo) ---
# CORS_ALLOWED_ORIGINS: lista separada por comas de origenes exactos que
# pueden llamar a la API desde el navegador (ver backend/shared/cors.py),
# ej. "http://localhost:5173,https://sentinelops.tuempresa.com". Si se
# deja vacio, se usa FRONTEND_URL (o http://localhost:5173) -- alcanza
# para el uso normal en una sola maquina. Solo hace falta setearlo si el
# frontend se sirve desde otro dominio/puerto.
CORS_ALLOWED_ORIGINS=

# ENCRYPTION_KEY: clave usada para cifrar en reposo el client_secret de
# SSO (auth-service) y las credenciales de los conectores de
# contencion/ticketing (integration-service) -- ver
# backend/shared/crypto.py. El launcher (Iniciar.exe) genera un valor
# random propio para esta instalacion la primera vez que crea .env; no
# hace falta tocar esto a mano, y NO copiar el valor de otra instalacion.
ENCRYPTION_KEY=changeme-generate-a-long-random-secret

# --- Asset / Scan / Vuln services ---
# Credenciales GMP para el driver OpenVAS de scan-service (ver
# backend/services/scan-service/app/scanners/openvas.py) -- requieren el
# stack GVM levantado (docker-compose.yml, seccion "OpenVAS/GVM") y el
# bootstrap de gvmd corrido una vez (ver README.md/STATUS.md). Sin
# GVM_PASSWORD, el driver reporta un error claro en vez de fallar mudo.
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock
GVM_USER=admin
# Password del usuario admin de GVM. Se crea/actualiza con el bootstrap
# de gvmd (ver README.md/STATUS.md), UNA vez, tras el primer
# `docker compose up`: debe coincidir con lo que se pase ahi.
GVM_PASSWORD=
# Timeout total (segundos) que scan-service espera a que termine un
# escaneo OpenVAS/GVM antes de marcarlo como fallido -- el escaneo en
# si puede seguir corriendo en gvmd igual. Subir para targets grandes.
GVM_SCAN_TIMEOUT_SECONDS=1500
EPSS_API_URL=https://api.first.org/data/v1/epss
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8001
VITE_ASSET_API_BASE_URL=http://localhost:8002
VITE_SCAN_API_BASE_URL=http://localhost:8003
VITE_VULN_API_BASE_URL=http://localhost:8004
VITE_SIEM_API_BASE_URL=http://localhost:8005
VITE_SOAR_API_BASE_URL=http://localhost:8006
VITE_CASE_API_BASE_URL=http://localhost:8007
VITE_PURPLE_API_BASE_URL=http://localhost:8008
VITE_REPORT_API_BASE_URL=http://localhost:8009
VITE_NOTIFICATION_API_BASE_URL=http://localhost:8010
VITE_INTEGRATION_API_BASE_URL=http://localhost:8011
VITE_THREATINTEL_API_BASE_URL=http://localhost:8012
VITE_ASM_API_BASE_URL=http://localhost:8013
VITE_CLOUD_API_BASE_URL=http://localhost:8014
VITE_CODEREPO_API_BASE_URL=http://localhost:8015

# --- SOAR / Integration / Notification (modo dry-run por defecto) ---
SOAR_DRY_RUN=true
INTEGRATION_DRY_RUN=true
NOTIFICATION_DRY_RUN=true

# SMTP para el canal de notificaciones por email (opcional -- solo si
# vas a crear un canal 'email'; los canales Slack/webhook no lo usan).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sentinelops@tuempresa.com

# --- Threat Intel (threatintel-service) ---
# API key de AbuseIPDB (https://www.abuseipdb.com/account/api) -- free
# tier: 1000 consultas/dia. Si se deja vacia, threatintel-service NUNCA
# llama a la API (evita gastar cupo) y devuelve "no se pudo chequear"
# para toda IP publica.
ABUSEIPDB_API_KEY=
# MISP (opcional, mejor esfuerzo) -- si cualquiera de las dos queda
# vacia, esa fuente se omite en silencio.
MISP_URL=
MISP_API_KEY=

# --- ASM service (monitoreo de superficie externa) ---
# Cada cuantas horas corre el chequeo automatico de todos los dominios
# monitoreados habilitados (descubrimiento via crt.sh + chequeo TLS).
ASM_CHECK_INTERVAL_HOURS=12

# --- Cloud service (inventario/hallazgos de una cuenta de AWS, solo lectura) ---
# Reutiliza ENCRYPTION_KEY (ya definida arriba, ver backend/shared/crypto.py)
# para cifrar en reposo access_key_id/secret_access_key de cada cuenta de
# AWS conectada -- no hace falta una clave nueva.
#
# Cada cuantas horas corre el sync automatico de todas las cuentas de AWS
# habilitadas (inventario EC2/S3 + deteccion de buckets publicos y security
# groups abiertos a 0.0.0.0/0).
CLOUD_SYNC_INTERVAL_HOURS=6

# Las credenciales de AWS se configuran via la API/UI (POST /accounts),
# NUNCA por env vars. Referencia: el usuario/rol IAM que hay que crear en
# la cuenta de AWS del cliente necesita EXACTAMENTE esta politica de solo
# lectura (nada de Create*/Modify*/Delete*/Put*):
#
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Sid": "SentinelOpsCloudServiceReadOnly",
#       "Effect": "Allow",
#       "Action": [
#         "ec2:DescribeInstances",
#         "ec2:DescribeSecurityGroups",
#         "s3:ListAllMyBuckets",
#         "s3:GetBucketAcl",
#         "s3:GetBucketPolicyStatus",
#         "s3:GetPublicAccessBlock",
#         "s3:GetBucketLocation"
#       ],
#       "Resource": "*"
#     }
#   ]
# }

# --- Coderepo service (secretos en git + dependencias vulnerables) ---
# Cada cuanto coderepo-service clona y vuelve a escanear (gitleaks +
# trivy fs) todos los repositorios habilitados. Default 24hs -- clonar +
# escanear un repo completo (todo el historial de git) es mas pesado que
# un chequeo de dominio/cuenta AWS.
CODEREPO_SCAN_INTERVAL_HOURS=24
# Reutiliza ENCRYPTION_KEY (ya definida arriba) para cifrar el token de
# GitHub de los repositorios privados registrados.
